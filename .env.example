# Copy to .env and fill in. Prisma CLI reads .env (not .env.local).

# PostgreSQL connection string. Any Postgres 14+ works.
# Local dev example:  postgresql://postgres:postgres@localhost:5432/osc
# Hosted example:     the "Internal Database URL" your platform gives you.
DATABASE_URL=""

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Needed when running behind a hosting platform's reverse proxy
# (Render, Railway, Fly.io, etc. all terminate TLS in front of the app).
AUTH_TRUST_HOST="true"

# First-boot admin account. The app creates it automatically at startup
# (instrumentation.ts → lib/bootstrap-db.ts). ADMIN_PASSWORD is required
# in production — without it no admin account is created.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# YouTube Data API v3 key — ONLY needed for the mass playlist-import feature
# (/import) and rich YouTube descriptions. Single-video submits work without
# it (they use keyless oEmbed). Get a free key:
# console.cloud.google.com → create project → enable "YouTube Data API v3"
# → Credentials → Create credentials → API key
YOUTUBE_API_KEY=""
